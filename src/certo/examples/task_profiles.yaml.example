# task_profiles.yaml: the task profiles --auto-model chooses a model with.
# Optional: without it, --auto-model ranks every enabled model with no
# weights, so the order of models_list.yaml decides.
#
# Certo ships this file only as an example and never reads the example.
# Copy it to task_profiles.yaml (in your project folder, or in
# ~/.config/certo/, or set CERTO_TASK_PROFILES_FILE) and edit it. Every
# `model:` here names a model from models_list.yaml. See
# docs/guides/pick-models-automatically.md.
#
# =============================================================================
# DETERMINISTIC TASK -> WEIGHT-VECTOR CLASSIFICATION
# =============================================================================
#
# Deterministic (no LLM call) task -> weight-vector classification. The
# task's first line with text (a task file's title, or the whole task when
# it is one line) is matched against each profile's `triggers`, as whole
# words (a plain plural also matches: "bug" matches "bugs"), IN THE ORDER
# PROFILES ARE DECLARED BELOW — the first one that matches wins, so put a
# more specific profile earlier if its triggers could also appear in a
# broader one. `default` is the fallback when nothing else matches; its own
# position doesn't matter for that purpose, but keep it last for
# readability.
#
# A milestone of a task written in milestones is classified by its own
# title first ("## Milestone 2: Fix the flaky tests" is `debugging`), and
# by the task's title when its own has no trigger word.
#
# A profile can also name a model with `model:` (a name from
# models_list.yaml): that model runs first when it is enabled in
# models.yaml, and the weights order the fallbacks after it.
#
# Add your own axes/profiles freely — scoring just sums whatever keys a
# profile's `weights` declares against whatever `ratings` each model
# provides (see the ratings/weights note at the top of models_list.yaml for
# how `cost` in particular is scored).

task_profiles:
  # High correctness + deep reasoning + coding.
  debugging:
    triggers: [fix, bug, crash, "failing test", "race condition", debug, debugging, error, exception, regression]
    # Optional: always run this model first for the profile, whatever the
    # weights say (used only when it is enabled in models.yaml).
    # model: claude-sonnet-5-5
    weights: {reasoning: 3, precision: 2, code: 2, cost: 0.5}

  # Cheap generation/scaffolding. Don't waste frontier inference here.
  scaffolding:
    triggers: [scaffold, "create a new", "set up", setup, boilerplate, initialize, initialization, "starter project", template, prototype]
    weights: {cost: 2, code: 1, reasoning: 0.5, precision: 0.5}

  # Code quality matters more than raw generation speed.
  refactor:
    triggers: [refactor, "clean up", simplify, restructure, redesign, optimize, modernization]
    weights: {code: 2, precision: 2, reasoning: 1, cost: 0.5}

  # Architecture needs stronger reasoning and precision.
  architecture:
    triggers: [architecture, "system design", "design system", "technical design", "architecture decision", ADR, "distributed system", scalability, "data architecture"]
    weights: {reasoning: 3, precision: 3, code: 1, cost: 0.5}

  # Research / analysis favors reasoning and precision.
  research:
    triggers: [research, analyze, analysis, investigate, compare, evaluate, "deep dive", "trade-off", "tradeoff"]
    weights: {reasoning: 3, precision: 3, code: 0.5, cost: 0.5}

  # High-volume mechanical work should bias heavily toward cheap models.
  extraction:
    triggers: [extract, extraction, classify, classification, categorize, normalize, transform, parse, summarize]
    weights: {cost: 3, precision: 2, reasoning: 0.5, code: 0}

  # Agentic tasks need reasoning + code, with cost still relevant.
  agent:
    triggers: [agent, agentic, "multi-step", "long-running", "tool use", tools, automate, automation, workflow]
    weights: {reasoning: 3, code: 2, precision: 2, cost: 1}

  # Building an app, a game or a feature: code matters most, cost as much,
  # since a build is long. Late in the list, so a "fix" or "refactor" in
  # the same title wins.
  build:
    triggers: [build, implement, app, application, game, website, feature]
    weights: {code: 3, cost: 3, reasoning: 0.5, precision: 0.5}

  # Default balanced profile — used when nothing above matches.
  default:
    weights: {reasoning: 1, cost: 3, precision: 1, code: 1}
