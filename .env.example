# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Certo reads, per variable: the environment, then ./.env, then the user
# settings file ~/.config/certo/.env (or $XDG_CONFIG_HOME/certo/.env),
# which `certo init` writes for all projects.

# --- The ONLY line you change to switch provider/model ---
# The model for a plain `certo "task"`, written provider/model (a LiteLLM
# model id): the part before the / says which provider, and so which key
# CERTO_LLM_API_KEY must hold. Not needed with --escalate or --auto-model
# (CERTO_MODEL_SELECTION below): the model files name every model.
# The defaults `certo init` offers, one per provider:
CERTO_LLM_MODEL=anthropic/claude-sonnet-5-5
# CERTO_LLM_MODEL=openai/gpt-6.1-sol
# CERTO_LLM_MODEL=gemini/gemini-3.8-flash
# Cheaper, and enough for small tasks:
# CERTO_LLM_MODEL=anthropic/claude-haiku-5-5
# CERTO_LLM_MODEL=openai/gpt-5.6-luna
# A local model with Ollama (also set CERTO_LLM_BASE_URL below):
# CERTO_LLM_MODEL=ollama/qwen3.8:27b
# Model ids change over time. These were checked against each provider's
# model list on 2026-10-15; if one errors, check the list again.

# The API key of the provider in CERTO_LLM_MODEL: an Anthropic key for
# anthropic/..., an OpenAI key for openai/..., a Gemini key for gemini/....
# With another provider's key, the first request fails with an
# authentication error (`certo check` shows it before a run).
# Leave it empty for a local model that needs none (set
# CERTO_LLM_BASE_URL instead), and with --escalate or --auto-model, where
# models.yaml holds each model's key.
# A key you already export in your shell can be used by name instead of
# pasted here, e.g. CERTO_LLM_API_KEY=${ANTHROPIC_API_KEY}
CERTO_LLM_API_KEY=
# Only for local/self-hosted models (e.g. http://localhost:11434). Leave blank otherwise.
# NOTE: python-dotenv does not strip a trailing "# comment" from a line whose
# value is otherwise blank — keep this line's value empty with no trailing text.
CERTO_LLM_BASE_URL=

# Provider-neutral reasoning effort, passed straight through to the SDK
# (LiteLLM translates it per-provider). Leave blank to use the SDK's own
# default ("high"); for ollama/ models blank means no reasoning, since most
# have no thinking mode. none or off sends no reasoning parameter at all.
# Common values: none | minimal | low | medium | high | xhigh | max — the
# SDK also accepts future provider-specific values.
CERTO_LLM_REASONING_EFFORT=

# How long one call to the model may take, in seconds, before it fails and
# is retried (blank = 300; 0 = no limit). Raise it for slow local models.
CERTO_LLM_TIMEOUT_SECONDS=

# The model's context window, in tokens. Empty: what the provider reports
# (for Ollama, Certo asks the server). For Ollama, a value here is also
# asked from the server, e.g. 32768.
CERTO_LLM_CONTEXT_TOKENS=

# When the conversation nearly fills the context window, summarize the
# older steps (same model) instead of failing. Set to 0 to turn this off.
CERTO_CONDENSE=

# Warn at the start of a run when the model's known context window is
# smaller than this many tokens (default 32768). Set to 0 to turn it off.
CERTO_CONTEXT_WARN_TOKENS=

# When the agent ends with a tool call written as text instead of making
# it (some local models do), send it back and let it go on, at most this
# many times per run (default 3). Set to 0 to turn this off.
CERTO_TOOL_CALL_REMINDERS=

# --- Certo policy (ours, not the LLM's) ---
# Every variable below is CERTO_*. The pre-rename HARNESS_* names are still
# read for one release as a deprecated fallback (CERTO_* wins if both are
# set) — see docs/reference/configuration.md.
# The folder the agent works in (ignored when --project is used).
CERTO_WORKSPACE=.
# The most steps the agent may take in one run (a safety cap).
CERTO_MAX_ITERATIONS=50
# never | always. always pauses for your approval before each tool call.
CERTO_CONFIRM_MODE=never
# Where the agent's tools run: local | docker.
CERTO_EXECUTION=local

# --- Projects: one subfolder per generated project (see docs/reference/commands.md) ---
# The parent folder: --project NAME works in CERTO_PROJECTS_DIR/NAME.
CERTO_PROJECTS_DIR=./projects

# --- Post-hoc test verification (see docs/concepts/how-verification-works.md) ---
# After the agent finishes, the harness itself re-runs the project's own
# checks (no LLM involved) rather than trusting the agent's self-report.
# always | never.
CERTO_VERIFY_TESTS=always
# How many fix-and-recheck cycles before giving up.
CERTO_MAX_VERIFY_RETRIES=2

# --- Shared, task-level wall-clock budget (see docs/concepts/safety.md) ---
# Spans the whole task — the initial run plus every verify/retry cycle —
# not just one SDK conversation.run() call.
CERTO_MAX_TASK_SECONDS=1800

# Opt-in: allow the agent to pause and ask a question instead of always
# pushing forward autonomously (only the CLI's --interactive prompts a real
# human at the terminal; setting this without a caller that answers has no
# useful effect — see docs/guides/interactive-mode.md).
CERTO_INTERACTIVE=no

# Opt-in: before the build, a separate conversation writes tests from the
# task and the project as it is then; after the verdict, Certo runs them
# and reports the result next to it, without changing the verdict. Local
# runs only. The same as --independent-tests.
CERTO_INDEPENDENT_TESTS=no

# How many sets of independent tests, each by its own writer (1 to 5). The
# result is "failed" only when most sets fail (2 of 3).
CERTO_INDEPENDENT_TESTS_SETS=3

# Let independent tests change the verdict: when most sets fail, a
# "verified" run ends "independent_failed" (exit 1). Turns the tests on.
# The same as --independent-tests-strict.
CERTO_INDEPENDENT_TESTS_STRICT=no

# Print the agent's full output: the whole system prompt, the task with the
# skills Certo adds, and the SDK's own logs. By default each is one line.
# The same as --verbose.
CERTO_VERBOSE=no

# --- Model selection (see docs/guides/pick-models-automatically.md and
# docs/guides/escalate-between-models.md). With manual (the default),
# CERTO_LLM_MODEL above is used and no model file is read. With auto or
# escalate the model files pick every model and hold its key, so
# CERTO_LLM_MODEL and CERTO_LLM_API_KEY above can stay empty.
# manual | auto | escalate. auto is --auto-model, escalate is --escalate.
CERTO_MODEL_SELECTION=manual

# auto and escalate read models_list.yaml (the catalog: models and ratings)
# and models.yaml (your keys and the models you use; git-ignored like
# .env), plus one optional file each: task_profiles.yaml for auto,
# escalation.yaml (your ladders) for escalate. Blank looks for each in the
# current folder, then in ~/.config/certo/. Certo ships all four only as
# .example files.
CERTO_MODELS_LIST_FILE=
CERTO_MODELS_FILE=
CERTO_TASK_PROFILES_FILE=
CERTO_ESCALATION_FILE=

# With CERTO_MODEL_SELECTION=escalate (the same as --escalate): the ladder
# from escalation.yaml to climb. Blank uses the ladder named default, or one
# Certo builds from the ratings.
CERTO_ESCALATION_LADDER=

# With escalation: what the next model starts from. continue (the default):
# the files as the previous model left them. restart: the files as they were
# before the first model (the previous work is kept as a checkpoint).
CERTO_ESCALATION_HANDOFF=

# A limit on what one task may spend, in US dollars (every model call,
# fix attempts and escalation rungs together). Certo stops the agent once
# the cost reaches it; failing work then ends cost_exhausted. Models with
# no known price count as 0. Blank means no limit.
CERTO_MAX_TASK_COST=

# --- Opt-in per-run artifacts directory (see docs/guides/run-records-and-costs.md) ---
# Blank (the default) disables this entirely. When set, every task run
# writes metadata, the full message transcript, and token/cost metrics to
# <this dir>/<project-or-_unscoped>/<run-id>/ — a separate, sibling
# directory to CERTO_PROJECTS_DIR, not nested inside any one project.
# Git-ignored by this repo's own .gitignore if left at the suggested
# relative default.
CERTO_ARTIFACTS_DIR=

# Set to 1 to skip the note printed before the agent edits a folder that
# already has files (uncommitted git changes, or not a git repository).
CERTO_NO_WORKTREE_WARNING=

# The `certo` command keeps the last run's state in the project's .certo/
# folder, so `certo --resume` can continue it. Set to 0 to turn this off.
CERTO_SAVE_STATE=

# Snapshots of the project during a run, in .certo/checkpoints/, so
# `certo rollback N` can put the files back. Needs git. Set to 0 to turn
# this off.
CERTO_CHECKPOINTS=

# --- Only consulted when CERTO_EXECUTION=docker ---
# The agent-server image, built automatically on first use.
CERTO_DOCKER_IMAGE=certo/agent-server:local
# linux/amd64 | linux/arm64. Blank means detect it from this machine.
CERTO_DOCKER_PLATFORM=

# --- Server-mode task registry persistence (see
# docs/guides/run-as-a-server.md). Only consulted by `certo-server`/`certo-admin`, not the
# `certo` CLI. Default ("memory", TTL=0) is byte-for-byte the pre-existing
# in-memory, unbounded, per-process behavior — every setting below is opt-in.
# memory | redis | sqlite | mysql | postgres.
CERTO_TASK_STORE=memory
# How many seconds a finished task's record is kept. 0 means forever.
CERTO_TASK_TTL_SECONDS=0

# sqlite (needs the "store-sqlite" extra: uv pip install -e ".[store-sqlite]")
CERTO_TASK_STORE_SQLITE_PATH=./certo_tasks.db

# mysql (needs "store-mysql": uv pip install -e ".[store-mysql]")
CERTO_TASK_STORE_MYSQL_HOST=localhost
CERTO_TASK_STORE_MYSQL_PORT=3306
CERTO_TASK_STORE_MYSQL_USER=root
CERTO_TASK_STORE_MYSQL_PASSWORD=
CERTO_TASK_STORE_MYSQL_DATABASE=certo

# postgres (needs "store-postgres": uv pip install -e ".[store-postgres]")
CERTO_TASK_STORE_POSTGRES_HOST=localhost
CERTO_TASK_STORE_POSTGRES_PORT=5432
CERTO_TASK_STORE_POSTGRES_USER=postgres
CERTO_TASK_STORE_POSTGRES_PASSWORD=
CERTO_TASK_STORE_POSTGRES_DATABASE=certo

# redis (needs "store-redis": uv pip install -e ".[store-redis]") — uses
# Redis's own native per-key expiration for the TTL above, not a purge sweep.
CERTO_TASK_STORE_REDIS_HOST=localhost
CERTO_TASK_STORE_REDIS_PORT=6379
CERTO_TASK_STORE_REDIS_DB=0
CERTO_TASK_STORE_REDIS_PASSWORD=
CERTO_TASK_STORE_REDIS_USE_TLS=false
